{
  "name": "chat-adapter-tiktok",
  "version": "0.1.0",
  "description": "TikTok Business Messaging adapter for Chat SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "chat": ">=4.40.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.40.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.0.0",
    "chat": "^4.40.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "adapter",
    "bot",
    "chat",
    "chat-adapter",
    "chat-sdk",
    "messaging",
    "tiktok",
    "tiktok-business-messaging"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
